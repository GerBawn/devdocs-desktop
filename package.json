{
  "private": true,
  "name": "devdocs-desktop",
  "version": "0.0.0-this-does-not-matter",
  "description": "Desktop client for devdocs.io",
  "author": {
    "name": "EGOIST",
    "email": "0x142857@gmail.com",
    "url": "https://github.com/egoist"
  },
  "license": "MIT",
  "main": "app/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "test": "pnpm run lint",
    "lint": "eslint .",
    "app": "DEBUG=devdocs-desktop:* electron app/index.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "release": "electron-builder",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GerBawn/devdocs-desktop.git"
  },
  "keywords": [
    "devdocs",
    "app",
    "electron"
  ],
  "bugs": {
    "url": "https://github.com/GerBawn/devdocs-desktop/issues"
  },
  "homepage": "https://github.com/GerBawn/devdocs-desktop#readme",
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@eslint/js": "^10.0.1",
    "dotenv": "^18.0.7",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "prettier": "^3.9.10"
  },
  "build": {
    "appId": "sh.egoist.devdocs",
    "productName": "DevDocs",
    "compression": "maximum",
    "asar": true,
    "afterSign": "scripts/notarize.js",
    "dmg": {
      "sign": false
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false
    },
    "linux": {
      "synopsis": "DevDocs desktop app",
      "category": "Development",
      "target": [
        "AppImage",
        "deb",
        "tar.xz"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.10.1"
}
